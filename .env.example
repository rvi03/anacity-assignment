# Copy to `.env` to override the defaults baked into docker/compose.yaml.
# Both the service stack and the application read connection settings from
# here, so there is one place to change a port or a credential.
#
# The password below is a local development default. It is committed
# deliberately: this stack binds to localhost and holds synthetic data only.
# A deployment supplies its own and never reads this file.
POSTGRES_USER=facility
POSTGRES_PASSWORD=facility_local_dev
POSTGRES_DB=facility
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
